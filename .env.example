# AI Request Triage Assistant — Environment Configuration Template
# Copy this file to .env.local for local overrides (never commit .env.local).

# Provider Selection: "mock" (offline default) or "gemini" (real AI)
# - mock mode works completely offline without an API key.
# - gemini mode requires a valid server-side GEMINI_API_KEY.
AI_PROVIDER=mock

# Selected Gemini Flash Model (e.g. gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash)
AI_MODEL=

# Server-Side Google Gemini API Key
# IMPORTANT SECURITY RULES:
# - Required ONLY when AI_PROVIDER=gemini.
# - This key is strictly server-side.
# - NEVER prefix with NEXT_PUBLIC_* or expose it to client-side code.
GEMINI_API_KEY=

# Optional Fallback Google Gemini API Key (used automatically if primary key hits quota or rate limits)
GEMINI_API_KEY1=

# Request Timeout in Milliseconds (default: 30000 = 30 seconds)
AI_TIMEOUT_MS=30000

# Maximum Retry Count for Transient Failures (e.g. 503, network drop)
AI_MAX_RETRIES=1
